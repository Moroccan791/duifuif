# pm5m environment template. Copy to .env and export, or set in your shell.
# NEVER commit a file containing a private key.

# ---- data / recording -------------------------------------------------------
PM5M_DB=data/pm5m.sqlite3
PM5M_SERIES_SLUG=btc-up-or-down-5m
PM5M_ASSET=btc

# ---- risk (these are deliberately tiny; raise them only after a paper track record)
PM5M_BANKROLL_USD=1000
PM5M_KELLY_FRACTION=0.25
PM5M_MAX_POSITION_USD=25
PM5M_MAX_TOTAL_EXPOSURE_USD=150
PM5M_MAX_DAILY_LOSS_USD=50

# ---- strategy mode ----------------------------------------------------------
# "maker" rests inside the spread and pays no fee. REQUIRED for 50-60c trading:
# a taker at 55c pays 1.73c/share (3.15% of stake) and must be 1.73pp more
# accurate than the market on every trade. Run `python -m pm5m band`.
PM5M_STRATEGY_MODE=taker
# ---- price band -------------------------------------------------------------
PM5M_MIN_PRICE=0.02
PM5M_MAX_PRICE=0.985

# ---- maker parameters -------------------------------------------------------
PM5M_MAKER_EDGE_CENTS=1.5
PM5M_MAKER_QUOTE_SHARES=40
# Explicit stress knob for adverse selection. Measure it from real fills; a
# model cannot tell you this number. Keep it at 0 until you have a measurement.
PM5M_ADVERSE_SELECTION_CENTS=0

# ---- signal thresholds ------------------------------------------------------
PM5M_MIN_EDGE_CENTS=1.0
PM5M_MIN_Z_LOCK=2.5
PM5M_LATENCY_S=0.35

# ---- live trading: all three must be set, plus the CLI flag -----------------
PM5M_LIVE=0
PM5M_DRY_RUN=1
# POLYMARKET_PRIVATE_KEY=0x...
# PM5M_CHAIN_ID=137
# PM5M_SIG_TYPE=2
# PM5M_FUNDER_ADDRESS=0x...
# PM5M_API_KEY=
# PM5M_API_SECRET=
# PM5M_API_PASSPHRASE=
